# Copy to .env and fill in. chmod 600 .env
#
# API key: https://trello.com/power-ups/admin -> your Power-Up -> API Key tab
#   The key alone grants no data access and is safe to expose.
# Token: visit the link below (substitute your key), approve, copy the token.
#   The token DOES grant full access to your boards. Never commit it.
#
#   https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_KEY&name=trello-focus
#
TRELLO_API_KEY=
TRELLO_TOKEN=
